{
  "name": "krdpass-auth-react-native",
  "version": "1.6.0",
  "description": "KRDPASS Auth SDK for React Native.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "//exports": [
    "The package root is the only supported entry point. Without this map every file",
    "under build/ and src/ is deep-importable and becomes a semver commitment on day one.",
    "app.plugin.js is listed because Expo config plugins are resolved by path, and",
    "package.json because React Native autolinking and Codegen read it directly."
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "!android/src/test",
    "ios",
    "krdpass-auth-react-native.podspec",
    "src",
    "!src/**/__tests__",
    "build",
    "plugin/build",
    "app.plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc && tsc -p plugin/tsconfig.json",
    "clean": "node -e \"for (const d of ['build', 'plugin/build']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.guard.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "krdpass",
    "auth"
  ],
  "author": "KRDPASS Team <integration@pass.krd>",
  "license": "MIT",
  "homepage": "https://github.com/ditkrg/krdpass-auth-sdk-react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native"
  },
  "bugs": {
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "expo": "~57.0.11",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-get-random-values": "2.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.84.0",
    "react-native-get-random-values": "^1.11.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "KrdpassAuthReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "krdpass.auth.reactnative"
    }
  },
  "//overrides": [
    "xcode still resolves uuid below 11.1.1, and expo prebuild pulls it in."
  ],
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@jridgewell/gen-mapping": "0.3.12"
  },
  "//allowScripts": [
    "npm 11's own install-script review list, not a third-party tool. Advisory today,",
    "blocking in a later npm. fsevents is macOS file watching, pulled in by jest."
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
