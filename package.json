{
  "name": "krdpass-auth-react-native",
  "version": "1.0.1",
  "description": "KRDPASS Auth SDK for React Native.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android",
    "ios",
    "src",
    "!src/**/__tests__",
    "build",
    "plugin/build",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p plugin/tsconfig.json",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "krdpass",
    "auth"
  ],
  "author": "KRDPASS Team <integration@pass.krd>",
  "license": "MIT",
  "homepage": "https://github.com/ditkrg/krdpass-auth-sdk-react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native"
  },
  "bugs": {
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native/issues"
  },
  "devDependencies": {
    "@expo/config-plugins": "~55.0.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "expo-module-scripts": "^55.0.2",
    "jest": "^29.7.0",
    "react-native-get-random-values": "~1.11.0",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-get-random-values": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "shell-quote": "^1.8.4",
    "postcss": "^8.5.10",
    "ws": "^8.20.1",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.7"
  }
