{
  "name": "krdpass-auth-react-native",
  "version": "1.2.0",
  "description": "KRDPASS Auth SDK for React Native.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/src",
    "ios",
    "krdpass-auth-react-native.podspec",
    "src",
    "!src/**/__tests__",
    "build",
    "plugin/build",
    "app.plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf build plugin/build && tsc && tsc -p plugin/tsconfig.json",
    "clean": "rimraf build plugin/build",
    "lint": "npm run typecheck",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "krdpass",
    "auth"
  ],
  "author": "KRDPASS Team <integration@pass.krd>",
  "license": "MIT",
  "homepage": "https://github.com/ditkrg/krdpass-auth-sdk-react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native"
  },
  "bugs": {
    "url": "https://github.com/ditkrg/krdpass-auth-sdk-react-native/issues"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "expo": "~57.0.8",
    "jest": "^29.7.0",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-get-random-values": "^1.11.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.81.0",
    "react-native-get-random-values": "^1.11.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "KrdpassAuthReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "krdpass.auth.reactnative"
    }
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "shell-quote": "^1.8.5",
    "postcss": "^8.5.10",
    "ws": "^8.20.1",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "@babel/core": "^7.29.7",
    "brace-expansion@1": "^1.1.16",
    "brace-expansion@5": "^5.0.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
